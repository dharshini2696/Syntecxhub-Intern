                    <td>Accountant</td>
                    <td>rahul@gmail.com</td>
                    <td>9876543212</td>
                </tr>
            </table>
        </center>
    </section>
    <hr>
    <!-- Attendance -->
    <section id="attendance">
        <center>
            <h2>Employee Attendance</h2>
            <table border="1" cellpadding="10">
                <tr>
                    <th>Employee ID</th>
                    <th>Employee Name</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
                <tr>
                    <td>EMP001</td>
                    <td>Arun Kumar</td>
                    <td>26-09-2026</td>
                    <td>Present</td>
                </tr>
                <tr>
                    <td>EMP002</td>
                    <td>Priya</td>
                    <td>26-09-2026</td>
                    <td>Present</td>
                </tr>
                <tr>
                    <td>EMP003</td>
                    <td>Rahul</td>
                    <td>26-09-2026</td>
                    <td>Absent</td>
                </tr>
            </table>
        </center>
    </section>
    <hr>
    <!-- Leave Management -->
    <section id="leave">
        <center>
            <h2>Leave Management</h2>
            <form>
                <table cellpadding="8">
                    <tr>
                        <td>Employee ID:</td>
                        <td>
                            <input type="text" required>
                        </td>
                    </tr>
                    <tr>
                        <td>Employee Name:</td>
                        <td>
                            <input type="text" required>
                        </td>
                    </tr>
                    <tr>
                        <td>Leave Type:</td>
                        <td>
                            <select>
                                <option>Casual Leave</option>
                                <option>Sick Leave</option>
                                <option>Emergency Leave</option>
                                <option>Earned Leave</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>From Date:</td>
                        <td>
                            <input type="date">
                        </td>
                    </tr>
                    <tr>
                        <td>To Date:</td>
                        <td>
                            <input type="date">
                        </td>
                    </tr>
                    <tr>
                        <td>Reason:</td>
                        <td>
                            <textarea rows="4" cols="30"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" align="center">
                            <input type="submit" value="Apply Leave">
                            <input type="reset" value="Clear">
                        </td>
                    </tr>
                </table>
            </form>
        </center>
    </section>
    <hr>
    <!-- Salary Details -->
    <section id="salary">
        <center>
            <h2>Salary Details</h2>
            <table border="1" cellpadding="10">
                <tr>
                    <th>Employee ID</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Basic Salary</th>
                    <th>Allowance</th>
