<!DOCTYPE html>
<html>
<head>
    <title>Employee Management System</title>
</head>
<body>
    <!-- Header -->
    <center>
        <h1>EMPLOYEE MANAGEMENT SYSTEM</h1>
        <hr>
        <a href="#home">Home</a> |
        <a href="#register">Employee Registration</a> |
        <a href="#employees">Employee Details</a> |
        <a href="#attendance">Attendance</a> |
        <a href="#leave">Leave Management</a> |
        <a href="#salary">Salary Details</a> |
        <a href="#contact">Contact</a>
        <hr>
    </center>
    <!-- Home -->
    <section id="home">
        <center>
            <h2>Welcome to Employee Management System</h2>
            <p>
                This system is designed to manage employee information,
                attendance, leave and salary details in an organized way.
            </p>
        </center>
    </section>
    <hr>
    <!-- Employee Registration -->
    <section id="register">
        <center>
            <h2>Employee Registration</h2>
            <form>
                <table cellpadding="8">
                    <tr>
                        <td>Employee ID:</td>
                        <td>
                            <input type="text" name="employee_id" required>
                        </td>
                    </tr>
                    <tr>
                        <td>Employee Name:</td>
                        <td>
                            <input type="text" name="employee_name" required>
                        </td>
                    </tr>
                    <tr>
                        <td>Date of Birth:</td>
                        <td>
                            <input type="date" name="dob">
                        </td>
                    </tr>
                    <tr>
                        <td>Gender:</td>
                        <td>
                            <input type="radio" name="gender" value="Male">
                            Male
                            <input type="radio" name="gender" value="Female">
                            Female
                        </td>
                    </tr>
                    <tr>
                        <td>Email:</td>
                        <td>
                            <input type="email" name="email" required>
                        </td>
                    </tr>
                    <tr>
                        <td>Phone:</td>
                        <td>
                            <input type="tel" name="phone">
                        </td>
                    </tr>
                    <tr>
                        <td>Department:</td>
                        <td>
                            <select name="department">
                                <option>Select Department</option>
                                <option>HR</option>
                                <option>IT</option>
                                <option>Finance</option>
                                <option>Marketing</option>
                                <option>Sales</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>Designation:</td>
                        <td>
                            <input type="text" name="designation">
                        </td>
                    </tr>
                    <tr>
                        <td>Joining Date:</td>
                        <td>
                            <input type="date" name="joining_date">
                        </td>
                    </tr>
                    <tr>
                        <td>Salary:</td>
                        <td>
                            <input type="number" name="salary">
                        </td>
                    </tr>
                    <tr>
                        <td>Address:</td>
                        <td>
                            <textarea name="address" rows="4" cols="30"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" align="center">
                            <input type="submit" value="Register">
                            <input type="reset" value="Clear">
                        </td>
                    </tr>
                </table>
            </form>
        </center>
    </section>
    <hr>
    <!-- Employee Details -->
    <section id="employees">
        <center>
            <h2>Employee Details</h2>
            <table border="1" cellpadding="10">
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
